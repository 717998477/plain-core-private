"""
A mounted volume. The phone reports one row per storage the platform
knows about (internal, SD card, each USB disk, the app-private dir);
the fields are all filled by the host, never derived here.
"""
type Mount {
	id: ID!
	name: String!
	path: String!
	mountPoint: String!
	fsType: String!
	totalBytes: Long!
	usedBytes: Long!
	freeBytes: Long!
	remote: Boolean!
	alias: String!
	driveType: DriveType!
	diskId: String!
}

type Mutation {
	clearAppCache: Boolean!
	restartHttpServer(httpPort: Int, httpsPort: Int): HttpServerState!
	checkAppUpdate(automatic: Boolean! = false): AppUpdateStatus!
	controlDlnaReceiver(input: DlnaReceiverInput!): JSON!
	regenerateTlsCertificate: [Int!]!
	importTlsCertificatePem(certificatePem: String!, privateKeyPem: String!): [Int!]!
	importTlsCertificatePkcs12(data: String!, password: String!): [Int!]!
	loginPeer(input: PeerLoginInput!): Boolean!
	logoutPeer(id: ID!): Boolean!
