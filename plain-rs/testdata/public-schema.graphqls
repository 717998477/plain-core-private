	removeAudioPlaylistItem(id: ID!, query: String!): ActionResult!
	"""
	Send a chat message. `target` is the chat target id — a bare peer id
	(an optional `peer:` prefix is accepted), or a `channel:<id>`
	prefixed channel id; same value space as the `chatItems` query.
	`content` is the message envelope JSON, same shape as
	`ChatItem.content`.
	"""
	sendChatItem(target: String!, content: String!): [ChatItem!]!
	"""
	Always true: an id that is already gone is the state the caller asked
	for, and the contract has no way to say "nothing was there".
	"""
	deleteChatItem(id: ID!): Boolean!
	deleteChatItems(query: String!): ActionResult!
	retryChatItem(id: ID!): ChatItem!
	createChatChannel(name: String!): ChatChannel!
	updateChatChannel(id: ID!, name: String!): ChatChannel!
	deleteChatChannel(id: ID!): Boolean!
	leaveChatChannel(id: ID!): Boolean!
	addChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	removeChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	acceptChatChannelInvite(id: ID!): Boolean!
	declineChatChannelInvite(id: ID!): Boolean!
	respondChannelInvite(id: ID!, accept: Boolean!): Boolean!
	pairDevice(input: PairingDeviceInput!): Boolean!
	cancelPairing(deviceId: ID!): Boolean!
	respondToPairing(input: PairingRequestInput!, accepted: Boolean!): Boolean!
	deletePeer(id: ID!): Boolean!
	unpairPeer(id: ID!): Boolean!
	deleteNotifications(ids: [ID!]!): ActionResult!
	"""
	`actionIndex` indexes [`Notification::reply_actions`], the
	reply-capable subset — not the plain action list.
	"""
	replyNotification(id: ID!, actionIndex: Int!, text: String!): Boolean!
	"""
	Write text into the system clipboard on behalf of the calling client.
	The write is recorded with the caller as source; the local watcher
	sees it but skips re-broadcasting (hash dedup), so there is no loop.
	"""
	setClipboard(text: String!): Boolean!
	"""
	Delete clipboard history entries matching the query DSL (`ids:` /
	`text:`; a bare word is a text LIKE). A blank query is rejected —
	send `all:true` to target everything.
	"""
	deleteClipboardItems(query: String!): ActionResult!
	startScreenMirror(audio: Boolean!): Boolean!
	stopScreenMirror: Boolean!
	"""
	Returns false when the device has not granted RECORD_AUDIO yet; the
	platform asks for it and the caller retries.
	"""
	requestScreenMirrorAudio: Boolean!
	requestScreenMirrorKeyFrame: Boolean!
	updateScreenMirrorQuality(mode: ScreenMirrorMode!): Boolean!
	enableImageSearch: Boolean!
	importImageSearchModel: Boolean!
	disableImageSearch: Boolean!
	cancelImageModelDownload: Boolean!
	"""
	`force` re-scans images that already have an embedding.
	"""
	startImageIndex(force: Boolean): Boolean!
	cancelImageIndex: Boolean!
	openAccessibilitySettings: Boolean!
	openWebSettings(feature: WebSettingsFeature): Boolean!
	"""
	Register a favorite folder and return the whole list.
	"""
	addFavoriteFolder(rootPath: String!, fullPath: String!): [FavoriteFolder!]!
	"""
	Remove the favorite folder identified by `fullPath` and return the
	whole list.
	"""
	removeFavoriteFolder(fullPath: String!): [FavoriteFolder!]!
	"""
	Set the favorite folder's display alias and return the whole list.
	"""
	setFavoriteFolderAlias(fullPath: String!, alias: String!): [FavoriteFolder!]!
	createTag(type: DataType!, name: String!): Tag!
	updateTag(id: ID!, name: String!): Tag!
	deleteTag(id: ID!): Boolean!
	"""
	Attaches every tag to every key the query matches. An empty query
	would tag the whole library, so it is rejected before the platform
	ever sees it.
	"""
	addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	"""
	Same key resolution as `addToTags`, minus the title and size the
	relation stub carries — removal has nothing to record.
	"""
	removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	"""
	One key, an explicit add and remove list. The stub's title and size are
	stored on the relation: the tag editor shows them without a second
	lookup, so dropping them would make a tagged row render blank.
	"""
	updateTagRelations(type: DataType!, item: TagRelationStub!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
	setUserPref(key: String!, value: JSON!): Boolean!
	removeUserPref(key: String!): Boolean!
	"""
	`row` is a JSON object of column values. A malformed one is reported
	as `false` rather than an error: this is a developer console, and the
	operator is the one who typed it.
	"""
	createDbTableRow(table: String!, row: String!): Boolean!
	deleteDbTableRows(table: String!, ids: [String!]!): Boolean!
	createFile(path: String!): File!
	renameFilePath(path: String!, name: String!): String
	"""
	Counts what was actually removed. A path that was already gone
	counts as zero, so the number is the delta rather than the request
	size.
	"""
	deleteFiles(paths: [String!]!): ActionResult!
	createZipArchive(paths: [String!]!, target: String!): String!
	extractZipArchive(path: String!, target: String!): String!
	cacheZipEntry(path: String!): String!
	createDir(path: String!): File!
	"""
	`false` rather than an error when the rename is refused: a name that
	is empty, a traversal segment, or an existing destination are all
	ordinary outcomes for a user typing in a rename box.
	"""
	renameFile(path: String!, name: String!): Boolean!
	writeTextFile(path: String!, content: String!, overwrite: Boolean!): File!
	copyFileToDirectory(src: String!, directory: String!, name: String!): String
	copyFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
	moveFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
	deleteChunks(fileId: String!): Boolean!
	"""
	Starts the merge and returns immediately; completion arrives over the
	websocket, and `mergeStatus` is the polling fallback for a lost event.
	"""
	mergeChunks(fileId: String!, totalChunks: Int!, path: String!, replace: Boolean!, totalSize: Long!): MergeTask!
	mergeAppFileChunks(fileId: String!, totalChunks: Int!, fileName: String!, totalSize: Long!): MergeTask!
	"""
	A blank query would match the whole library, and a bulk delete is
	not something a client should be able to aim at everything by
	accident — it is refused before the platform is asked.
	"""
	deleteMediaItems(type: MediaDataType!, query: String!): ActionResult!
	trashMediaItems(type: MediaDataType!, query: String!): ActionResult!
	restoreMediaItems(type: MediaDataType!, query: String!): ActionResult!
	"""
	The only media action that is also a storage write, so it is the
	only one that gates — the others just move rows between the library
	and the trash.
	"""
	moveMediaItems(type: MediaDataType!, query: String!, destDir: String!): ActionResult!
	createCrashReport(report: String!): String!
	clearAppLogs: Boolean!
	clearAppLogFiles: Boolean!
	stageAppRestore(path: String!): Boolean!
	exportAppBackup: String!
	exportAppLogs: String
	setTempValue(key: String!, value: String!): KeyValuePair!
	"""
	The app restarts itself; the response only acknowledges that the
	request was accepted, since the connection dies with the process.
	"""
	relaunchApp: Boolean!
	"""
	Renaming the device also re-publishes the mDNS advertisement, so a
	client that waits for the new name to appear does see it.
	"""
	updateDeviceName(name: String!): Boolean!
	startDiscovery: Boolean!
	stopDiscovery: Boolean!
	cacheRemoteFile(url: String!, name: String!): String!
	pauseDownload(messageId: ID!): Boolean!
	downloadPeerFile(messageId: ID!, peerId: ID!): Boolean!
	resumeDownload(messageId: ID!, peerId: ID!): Boolean!
	retryDownload(messageId: ID!, peerId: ID!): Boolean!
}

type NearbyDevice {
	id: ID!
	name: String!
	ips: [String!]!
	port: Int!
	deviceType: String!
	version: String!
	platform: String!
	lastSeen: String!
	discoveryMethods: [String!]!
	bestIp: String!
	status: String!
}

type Note {
	id: ID!
	title: String!
	content: String!
	deletedAt: Instant
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

input NoteInput {
	title: String!
	content: String!
}

type Notification {
	id: ID!
	"""
	Android FLAG_ONLY_ALERT_ONCE: re-posted updates must not sound/vibrate again.
	"""
	onlyOnce: Boolean!
	isClearable: Boolean!
	appId: ID!
	appName: String!
	postedAt: Instant!
	silent: Boolean!
	title: String!
	body: String!
	actions: [String!]!
	"""
	Subset of `actions` that support inline reply; `replyNotification`'s
	`actionIndex` indexes this list, not `actions`.
	"""
	replyActions: [String!]!
}

type Organization {
	company: String!
	title: String!
}

