	tags: [Tag!]!
}

type VideoFileInfo {
	width: Int!
	height: Int!
	durationMs: Long!
	rotation: Int!
	displayWidth: Int!
	displayHeight: Int!
	bitrate: Long!
	frameRate: Float!
	title: String!
	artist: String!
	album: String!
	genre: String!
	takenAt: Instant
	writer: String!
	composer: String!
	location: Location
}

type VideoPlayProgress {
	mediaId: ID!
	positionMs: Long!
	updatedAt: Instant!
}

enum WebSettingsFeature {
	FILES
	CONTACTS
	SMS
	CALL_LOGS
	CALL_PHONE
	PHONE_NUMBER
	APPS
	NOTIFICATIONS
	CLIPBOARD
}

enum WebsiteType {
	CUSTOM
	HOMEPAGE
	BLOG
	FTP
	HOME
	WORK
	OTHER
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
schema {
	query: Query
	mutation: Mutation
}
