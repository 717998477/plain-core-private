type Image implements MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	durationMs: Long!
	width: Int!
	height: Int!
	rotation: Int!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

type ImageEditorProject {
	id: ID!
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

input ImageEditorProjectInput {
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
}

type ImageEditorProjectSummary {
	id: ID!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	updatedAt: Instant!
}

type ImageHostIndexStatus {
	version: Long!
	isRunning: Boolean!
	totalImages: Long!
	indexedImages: Long!
	skippedImages: Long!
	errorMessage: String!
}

type ImageModelsState {
	version: Long!
	status: ImageSearchStatusType!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

type ImageSearchStatus {
	status: ImageSearchStatusType!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

enum ImageSearchStatusType {
	UNAVAILABLE
	DOWNLOADING
	LOADING
	READY
	ERROR
}

type SemanticImageMatch {
	imageId: ID!
	score: Float!
}

extend type Mutation {
	broadcastImageEditorUpdate(id: ID!, update: String!): Boolean!
	cancelImageIndex: Boolean!
	cancelImageIndexTask: ImageHostIndexStatus!
	cancelImageModelDownload: Boolean!
	deleteImageEditorProject(id: ID!): Boolean!
	disableImageSearch: Boolean!
	enableImageSearch: Boolean!
	importImageSearchModel: Boolean!
	indexSelectedImages(ids: [ID!]!): ImageHostIndexStatus!
	releaseImageModelMemory: Boolean!
	saveImageEditorProject(id: ID!, input: ImageEditorProjectInput!): ImageEditorProject!
	"""
	`force` re-scans images that already have an embedding.
	"""
	startImageIndex(force: Boolean): Boolean!
	startImageIndexTask(force: Boolean!): ImageHostIndexStatus!
}

extend type Query {
	imageCount(query: String!): Int!
	imageEditorProject(id: ID!): ImageEditorProject
	imageEditorProjectItems(query: String!, offset: Int!, limit: Int!): [ImageEditorProjectSummary!]!
	imageEditorProjects: [ImageEditorProjectSummary!]!
	imageIndexStatus: ImageHostIndexStatus!
	imageModelsState: ImageModelsState!
	imageSearchStatus: ImageSearchStatus!
	images(query: String!, offset: Int!, limit: Int!, sortBy: FileSortBy!): [Image!]!
	searchImageCount(text: String!, query: String!): Int!
	searchImages(text: String!, query: String!, offset: Int!, limit: Int!, sortBy: FileSortBy!): [Image!]!
	semanticImageSearch(text: String!, maxResults: Int!): [SemanticImageMatch!]!
}
