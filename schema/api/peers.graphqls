input PairingDeviceInput {
	id: ID
	host: String
	mode: PairingMode
	password: String
	generation: String
}

enum PairingMode {
	CHAT
	MANAGE
}

input PairingRequestInput {
	fromId: ID!
	fromName: String!
	port: Int!
	deviceType: DeviceType!
	ecdhPublicKey: String!
	signaturePublicKey: String!
	timestamp: Long!
	ips: [String!]!
	signature: String!
	fromIp: String!
	awareSupported: Boolean!
}

type PairingState {
	deviceId: ID
	generation: String!
	mode: PairingMode!
	phase: String!
	error: String
}

input PeerRecordInput {
	id: ID!
	name: String!
	ip: String!
	key: String!
	publicKey: String!
	status: String!
	port: Int
	deviceType: String!
	token: String!
	createdAt: Instant!
	updatedAt: Instant!
}

enum PeerStatusAction {
	RECONNECT
}

type Sim {
	id: ID!
	label: String!
	number: String!
	subscriptionId: Int!
}

extend type Mutation {
	cancelPairing(generation: String!): Boolean!
	controlPeerStatus(action: PeerStatusAction!): Boolean!
	deletePeer(id: ID!): Boolean!
	logoutPeer(id: ID!): Boolean!
	pairDevice(input: PairingDeviceInput!): PairingState!
	respondToPairing(input: PairingRequestInput!, accepted: Boolean!): Boolean!
	unpairPeer(id: ID!): Boolean!
	updatePeerName(id: ID!, name: String!): Boolean!
}

extend type Query {
	isPairingRequestCurrent(id: ID!, signature: String!): Boolean!
	pairingCode: String!
	pairingStates: [PairingState!]!
	peerFileUrl(id: ID!, expected: PeerRecordInput!, fileId: String!): String!
	peers: [Peer!]!
	"""
	The SIM slots the platform reports. Empty on a device with no
	telephony, which is the honest answer rather than an error.
	"""
	sims: [Sim!]!
}
