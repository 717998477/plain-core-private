type ActionResult {
	affectedCount: Int!
}

type AppUpdateDownload {
	coreId: ID!
	taskId: ID!
	revision: Long!
	status: AppUpdateDownloadStatus!
	progress: Int!
	filePath: String!
	error: String!
}

enum AppUpdateDownloadStatus {
	IDLE
	DOWNLOADING
	COMPLETED
	FAILED
	CANCELLED
}

type Audio implements MediaItem {
	albumId: ID!
	id: ID!
	title: String!
	artist: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	isFavorite: Boolean!
	albumFileId: String!
	tags: [Tag!]!
}

type AudioPlaybackChange {
	revision: Long!
	positionMs: Long!
}

type ChannelChange {
	changed: Boolean!
	invite: ChannelInvite
	cancel: ChannelInviteCancellation
}

type ChannelInvite {
	channelId: ID!
	ownerPeerId: ID!
	ownerPeerName: String!
}

type ChannelInviteCancellation {
	channelId: ID!
	ownerPeerId: ID!
}

type ClipboardChange {
	text: String!
	sensitive: Boolean!
	time: Long!
}

enum DeviceType {
	COMPUTER
	PHONE
	TABLET
	TV
	NAS
	OTHER
}

type Doc implements MediaItem {
	durationMs: Long!
	id: ID!
	title: String!
	path: String!
	extension: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

type FeedSyncChange {
	feedId: ID!
	error: String
	cancelled: Boolean
}

type FeedSyncUpdate {
	states: [FeedSyncState!]!
	removed: [ID!]!
}

enum FileSortBy {
	DATE_ASC
	DATE_DESC
	SIZE_ASC
	SIZE_DESC
	NAME_ASC
	NAME_DESC
	TAKEN_AT_DESC
}

type Image implements MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	width: Int!
	height: Int!
	rotation: Int!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

type ImageModelsUpdate {
	version: Long!
	status: String!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

scalar Instant

type LibraryChange {
	types: [Int!]!
}

scalar Long

"""
Media-library item kinds accepted by media item actions and buckets
(plain-app `MediaDataType`).
"""
enum MediaDataType {
	AUDIO
	VIDEO
	IMAGE
	DOC
}

type MirrorCodecConfiguration {
	annexB: String!
}

type MirrorState {
	running: Boolean!
}

type MmsSendResult {
	pendingId: ID!
	success: Boolean!
	resultCode: Int
}

type PairingRequestNotice {
	fromId: ID!
	fromName: String!
	port: Int!
	deviceType: String!
	ecdhPublicKey: String!
	signaturePublicKey: String!
	timestamp: Long!
	ips: [String!]!
	signature: String!
	fromIp: String!
	awareSupported: Boolean!
}

type PairingSuccessNotice {
	deviceId: ID!
	key: String!
}

type Peer {
	id: ID!
	name: String!
	ip: String!
	status: PeerStatus!
	port: Int
	deviceType: DeviceType!
	createdAt: Instant!
	updatedAt: Instant!
	online: Boolean!
	key: String!
	publicKey: String!
	token: String!
	address: PeerAddress
}

type PeerAddress {
	bestIp: String!
	name: String!
	baseUrl: String!
	apiUrl: String!
	statusWsUrl: String!
}

type PeerClipboardChange {
	peerId: ID!
}

enum PeerStatus {
	PAIRED
	UNPAIRED
	CHANNEL
}

type PeerTransportState {
	peerId: ID!
	transport: String!
}

type PomodoroAction {
	today: PomodoroToday!
	completedState: PomodoroState
}

type SmsProviderChange {
	uris: [String!]!
}

type SmsSendResult {
	requestId: ID
	success: Boolean!
	resultCode: Int
}

type Subscription {
	networkChanged: Boolean!
	httpServerChanged: Boolean!
	audioLibraryChanged: Boolean!
	clipboardHistoryChanged: Boolean!
	peersChanged: Boolean!
	channelsChanged: ChannelChange!
	mdnsChanged: Boolean!
	nearbyDevicesChanged: Boolean!
	downloadsChanged: Boolean!
	sharedFolderDownloadsChanged: Boolean!
	dlnaRendererChanged: Boolean!
	dlnaSenderUpdated: DlnaSenderState!
	peerTransportsUpdated: [PeerTransportState!]!
	onlineClientsUpdated: [String!]!
	imageModelsUpdated: ImageModelsUpdate!
	appUpdateDownloadUpdated: AppUpdateDownload!
	feedSyncUpdated: FeedSyncUpdate!
	audioPlaybackChanged: AudioPlaybackChange!
	pairingChanged: Boolean!
	pairingRequested: PairingRequestNotice!
	pairingSucceeded: PairingSuccessNotice!
	pomodoroAction: PomodoroAction!
	deviceNameUpdated: String!
	permissionsUpdated: Boolean!
	contentChanged: Boolean!
	clipboardChanged: ClipboardChange!
	peerClipboardChanged: PeerClipboardChange!
	screenMirrorState: MirrorState!
	screenMirrorVideoCodec: MirrorCodecConfiguration
	screenMirrorAudioGranted: Boolean!
	notificationCreated: Notification!
	notificationUpdated: Notification!
	notificationDeleted: Notification!
	notificationRefreshed: Boolean!
	messagesCreated: [ChatItem!]!
	messagesUpdated: [ChatItem!]!
	messagesDeleted: String!
	mediaLibraryUpdated: LibraryChange!
	mediaScanProgress: ScanProgress!
	bookmarksUpdated: [Bookmark!]!
	feedsFetched: FeedSyncChange!
	uploadMergeResult: UploadMergeResult!
	smsProviderChanged: SmsProviderChange
	smsSendResult: SmsSendResult!
	mmsSendResult: MmsSendResult!
	mmsSent: String!
}

type Tag {
	id: ID!
	name: String!
	type: Int!
	count: Int!
}

type UploadMergeResult {
	fileId: ID!
	ok: Boolean!
	value: String
	mergedSize: Long
	error: String
}

type Video implements MediaItem {
	width: Int!
	height: Int!
	rotation: Int!
	id: ID!
	title: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
}
