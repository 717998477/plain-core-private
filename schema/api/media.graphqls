enum MediaAction {
	TRASH
	RESTORE
	DELETE
	MOVE
}

type MediaActionOutcome {
	affectedCount: Int!
	failedIds: [ID!]!
}

type MediaBucket {
	size: Long!
	id: ID!
	name: String!
	itemCount: Int!
	topItemPaths: [String!]!
}

type ScanProgress {
	indexed: Int!
	pending: Int
	total: Int
	state: ScanState!
	error: String
}

"""
Media-index scan lifecycle, shared by `scanProgress.state` and the
`media:scan:progress` WS payload (same values on both wires).
"""
enum ScanState {
	IDLE
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

extend type Mutation {
	mediaAction(type: DataType!, action: MediaAction!, ids: [ID!]!, fromTrash: Boolean!, destDir: String!): MediaActionOutcome!
	pauseMediaScan: Boolean!
	rebuildMediaIndex(root: String!): Boolean!
	resumeMediaScan: Boolean!
	setMediaSourceDirs(dirs: [String!]!): Boolean!
	startMediaScan(root: String!): Boolean!
	stopMediaScan: Boolean!
}

extend type Query {
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	mediaIds(type: MediaDataType!, query: String!, fromTrash: Boolean! = false): [ID!]!
	mediaSourceDirs: [String!]!
	scanProgress: ScanProgress!
}
