type MediaBucket {
	size: Long!
	id: ID!
	name: String!
	itemCount: Int!
	topItemPaths: [String!]!
}

type MediaPlayHistory {
	mediaId: ID!
	mediaType: MediaDataType!
	positionMs: Long!
	playCount: Long!
	playedAt: Instant!
	media: MediaItem!
}

type ScanProgress {
	indexed: Int!
	pending: Int
	total: Int
	state: ScanState!
	error: String
}

"""
Media-index scan lifecycle, shared by `scanProgress.state` and the
`media:scan:progress` WS payload (same values on both wires).
"""
enum ScanState {
	IDLE
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

extend type Mutation {
	pauseMediaScan: Boolean!
	recordMediaPlay(mediaId: ID!, type: MediaDataType!, positionMs: Long!): Boolean!
	rebuildMediaIndex(root: String!): Boolean!
	resumeMediaScan: Boolean!
	saveMediaPlayProgress(mediaId: ID!, type: MediaDataType!, positionMs: Long!): Boolean!
	setMediaSourceDirs(dirs: [String!]!): Boolean!
	stopMediaScan: Boolean!
}

extend type Query {
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	mediaPlayHistory(query: String!, offset: Int!, limit: Int!): [MediaPlayHistory!]!
	mediaSourceDirs: [String!]!
	scanProgress: ScanProgress!
}
