type Sms {
	id: ID!
	body: String!
	address: String!
	sentAt: Instant!
	serviceCenter: String!
	read: Boolean!
	threadId: ID!
	type: SmsType!
	typeCode: Int!
	subscriptionId: Int!
	isMms: Boolean!
	attachments: [SmsAttachment!]!
	tags: [Tag!]!
}

type SmsArchiveRecord {
	conversationId: ID!
	archivedAt: Instant!
}

type SmsAttachment {
	path: String!
	contentType: String!
	name: String!
}

type SmsConversation {
	id: ID!
	address: String!
	snippet: String!
	lastMessageAt: Instant!
	messageCount: Int!
	read: Boolean!
	addresses: [String!]!
}

type SmsCounts {
	total: Int!
	inbox: Int!
	sent: Int!
	drafts: Int!
}

enum SmsType {
	INBOX
	SENT
	DRAFT
	OUTBOX
	FAILED
	QUEUED
	UNKNOWN
}

extend type Mutation {
	archiveSmsConversation(id: ID!, date: Instant): Boolean!
	deleteSms(query: String!): ActionResult!
	restoreSms(query: String!): ActionResult!
	"""
	Compose an MMS in the device's default SMS app and track the send.
	Returns a pendingId consumed by the MMS polling flow.
	"""
	sendMms(number: String!, body: String!, attachmentPaths: [String!]!, threadId: ID!): String!
	"""
	`subscriptionId` picks the SIM (-1 = system default, see `sims`);
	`requestId` is an optional idempotency key that dedupes retried sends.
	"""
	sendSms(number: String!, body: String!, subscriptionId: Int!, requestId: String): Boolean!
	trashSms(query: String!): ActionResult!
	unarchiveSmsConversation(id: ID!): Boolean!
}

extend type Query {
	archivedSmsConversations(query: String!, offset: Int!, limit: Int!): [SmsConversation!]!
	sms(query: String!, offset: Int!, limit: Int!, includeTrashed: Boolean! = false): [Sms!]!
	smsArchiveRecords: [SmsArchiveRecord!]!
	smsBoxCounts: SmsCounts!
	smsConversationCount(query: String!): Int!
	smsConversationDate(id: ID!): Instant
	smsConversations(query: String!, offset: Int!, limit: Int!): [SmsConversation!]!
	smsCount(query: String!): Int!
	smsIds(query: String!, includeTrashed: Boolean! = false): [ID!]!
	trashedSmsIds: [ID!]!
}
