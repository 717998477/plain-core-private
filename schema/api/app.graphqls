type AppUpdate {
	currentVersion: String!
	latestVersion: String
	releaseName: String!
	publishedAt: Instant
	hasUpdate: Boolean!
	url: String
}

type AuditEvent {
	id: ID!
	type: AuditEventType!
	message: String!
	clientId: String
	createdAt: Instant!
}

enum AuditEventType {
	LOGIN
	LOGIN_FAILED
	LOGOUT
	REVOKE
	SET_HOSTNAME
	UPDATE_DEVICE_NAME
	MOUNT
	MOUNT_FAILED
	UNMOUNT
	FORMAT_DISK
	FORMAT_DISK_FAILED
}

type Disk {
	id: ID!
	name: String!
	path: String!
	sizeBytes: Long!
	removable: Boolean!
	model: String
}

type SambaSettings {
	enabled: Boolean!
	username: String!
	hasPassword: Boolean!
	shares: [SambaShare!]!
	serviceName: String!
	serviceActive: Boolean!
	serviceEnabled: Boolean!
}

input SambaSettingsInput {
	enabled: Boolean!
	shares: [SambaShareInput!]!
}

type SambaShare {
	name: String!
	sharePath: String!
	auth: SambaShareAuth!
	readOnly: Boolean!
}

enum SambaShareAuth {
	GUEST
	PASSWORD
}

input SambaShareInput {
	name: String!
	sharePath: String!
	auth: SambaShareAuth!
	readOnly: Boolean!
}

type Mutation {
	clearAppCache: Boolean!
	formatDisk(path: String!): Boolean!
	setHostname(name: String!): Boolean!
	setMountAlias(id: ID!, alias: String!): Boolean!
	setSambaSettings(input: SambaSettingsInput!): Boolean!
	setSambaUserPassword(password: String!): Boolean!
}

type Query {
	appCacheSize: Long!
	appUpdate: AppUpdate!
	auditEvents(query: String!, offset: Int!, limit: Int!): [AuditEvent!]!
	disks: [Disk!]!
	sambaSettings: SambaSettings!
}
