"""
The contract's `Tag` carries no numeric kind — that lives in the
`tags(type:)` filter instead — so it is not `content_types::Tag`.
"""
type Contact {
	id: ID!
	prefix: String!
	firstName: String!
	middleName: String!
	lastName: String!
	suffix: String!
	nickname: String!
	photoId: String!
	phoneNumbers: [ContactPhoneNumber!]!
	emails: [ContactEmail!]!
	addresses: [ContactAddress!]!
	events: [ContactEvent!]!
	source: String!
	starred: Boolean!
	contactId: ID!
	thumbnailId: String!
	notes: String!
	groups: [ContactGroup!]!
	organization: Organization
	websites: [ContactWebsite!]!
	ims: [ContactIm!]!
	ringtone: String!
	updatedAt: Instant!
	tags: [Tag!]!
}

type ContactAddress {
	typeCode: Int!
	value: String!
	type: PostalType!
	label: String!
}

input ContactAddressInput {
	value: String!
	type: PostalType!
	label: String!
}

type ContactEmail {
	typeCode: Int!
	value: String!
	type: EmailType!
	label: String!
}

input ContactEmailInput {
	value: String!
	type: EmailType!
	label: String!
}

type ContactEvent {
	typeCode: Int!
	value: String!
	type: EventType!
	label: String!
}

input ContactEventInput {
	value: String!
	type: EventType!
	label: String!
}

type ContactGroup {
	id: ID!
	name: String!
	contactCount: Int!
}

type ContactIm {
	typeCode: Int!
	value: String!
	protocol: ImProtocol!
	customProtocol: String!
}

input ContactImInput {
	value: String!
	protocol: ImProtocol!
	customProtocol: String!
}

input ContactInput {
	prefix: String!
	firstName: String!
	middleName: String!
	lastName: String!
	suffix: String!
	nickname: String!
	phoneNumbers: [ContactPhoneInput!]!
	emails: [ContactEmailInput!]!
	addresses: [ContactAddressInput!]!
	events: [ContactEventInput!]!
	source: String!
	starred: Boolean!
	notes: String!
	groupIds: [ID!]!
	organization: OrganizationInput
	websites: [ContactWebsiteInput!]!
	ims: [ContactImInput!]!
}

input ContactPhoneInput {
	value: String!
	type: PhoneType!
	label: String!
}

type ContactPhoneNumber {
	typeCode: Int!
	value: String!
	type: PhoneType!
	label: String!
	normalizedNumber: String!
}

type ContactSource {
	name: String!
	type: String!
}

type ContactWebsite {
	typeCode: Int!
	value: String!
	type: WebsiteType!
	label: String!
}

input ContactWebsiteInput {
	value: String!
	type: WebsiteType!
	label: String!
}

enum EmailType {
	CUSTOM
	HOME
	WORK
	OTHER
	MOBILE
}

enum EventType {
	CUSTOM
	ANNIVERSARY
	BIRTHDAY
	OTHER
}

enum ImProtocol {
	CUSTOM
	AIM
	MSN
	YAHOO
	SKYPE
	QQ
	GOOGLE_TALK
	ICQ
	JABBER
	NETMEETING
}

type Organization {
	company: String!
	title: String!
}

input OrganizationInput {
	company: String!
	title: String!
}

enum PhoneType {
	CUSTOM
	HOME
	MOBILE
	WORK
	FAX_WORK
	FAX_HOME
	PAGER
	OTHER
	CALLBACK
	CAR
	COMPANY_MAIN
	ISDN
	MAIN
	OTHER_FAX
	RADIO
	TELEX
	TTY_TDD
	WORK_MOBILE
	WORK_PAGER
	ASSISTANT
}

enum PostalType {
	CUSTOM
	HOME
	WORK
	OTHER
}

enum WebsiteType {
	CUSTOM
	HOMEPAGE
	BLOG
	FTP
	HOME
	WORK
	OTHER
}

extend type Mutation {
	createContact(input: ContactInput!): Contact!
	createContactGroup(name: String!, accountName: String!, accountType: String!): ContactGroup!
	deleteContactGroup(id: ID!): Boolean!
	deleteContacts(query: String!): ActionResult!
	updateContact(id: ID!, input: ContactInput!): Contact!
	updateContactGroup(id: ID!, name: String!): ContactGroup!
}

extend type Query {
	contactCount(query: String!): Int!
	contactGroups: [ContactGroup!]!
	"""
	plain-app degrades this to 0 rather than erroring when the web client
	was not granted the contact permission.
	"""
	contactIds(query: String!): [ID!]!
	contactSources: [ContactSource!]!
	contacts(query: String!, offset: Int!, limit: Int!): [Contact!]!
}
