"""
Taggable data domains — the plain-app `DataType` wire enum
(`shared/src/commonMain/kotlin/com/ismartcoding/plain/enums/DataType.kt`).
GraphQL-arg and tag-column domain; `kind()` is the ordinal stored in
the shared library db `type` column.
"""
enum DataType {
	DEFAULT
	AUDIO
	VIDEO
	IMAGE
	SMS
	CONTACT
	NOTE
	FEED_ENTRY
	CALL
	PACKAGE
	FILE
	APP_FILE
	DOC
}

type TagRelation {
	tagId: ID!
	key: String!
}

extend type Mutation {
	addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	createTag(type: DataType!, name: String!): Tag!
	deleteTag(id: ID!): Boolean!
	removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	updateTag(id: ID!, name: String!): Tag!
	updateTagRelations(type: DataType!, keys: [String!]!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
}

extend type Query {
	tagKeys(id: ID!): [String!]!
	tagRelations(type: DataType!, keys: [String!]!): [TagRelation!]!
	tags(type: DataType!): [Tag!]!
}
